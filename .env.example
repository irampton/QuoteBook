# AI completion service. The app also accepts a complete OpenAI-compatible
# chat-completions URL here.
COMPLETION_URL=https://dev.aqanta.com/
COMPLETION_API_KEY=
COMPLETION_MODEL=
COMPLETION_TIMEOUT_MS=30000
COMPLETION_JSON_MODE=true

PORT=3000
DATABASE_PATH=./server/data/quotebook.db
CLIENT_ORIGIN=
# Set only when deployed behind a trusted reverse proxy (for correct client IPs).
TRUST_PROXY=

# Optional search provider used by the AI research harness.
SEARCH_API_URL=
SEARCH_API_KEY=

# Wikiquote is queried through its official MediaWiki API during online lookups.
WIKIQUOTE_ENABLED=true
WIKIQUOTE_LANGUAGE=en
WIKIQUOTE_TIMEOUT_MS=8000
WIKIQUOTE_MAX_RESULTS=4
