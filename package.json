{
  "name": "quotebook",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "description": "A private, searchable home for meaningful quotes.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "prestart": "npm run build",
    "start": "npm --workspace server start",
    "test": "npm --workspace server test"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
